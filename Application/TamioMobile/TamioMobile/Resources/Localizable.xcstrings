    "Reached %lld tool rounds in one pass. Click Continue to keep going.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reached %lld tool rounds in one pass. Click Continue to keep going."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の処理で %lld 回のツール呼び出しに達しました。「続行」をクリックして続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 실행에서 도구 호출 %lld회에 도달했습니다. 계속하려면 계속을 클릭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次已连续执行 %lld 轮工具调用。点击「继续执行」可无缝继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單次已連續執行 %lld 輪工具呼叫。點擊「繼續執行」可無縫繼續。"
          }
        }
      }
    },
