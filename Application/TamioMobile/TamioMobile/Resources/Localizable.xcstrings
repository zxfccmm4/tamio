        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio の接続エンジンは SSH 証明書およびハードウェアセキュリティキーに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 연결 엔진에서는 SSH 인증서 및 하드웨어 보안 키를 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
