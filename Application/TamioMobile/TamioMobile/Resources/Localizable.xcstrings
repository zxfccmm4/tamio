    "API keys are stored only in your device Keychain. Server passwords and SSH private keys are never sent to any AI provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys are stored only in your device Keychain. Server passwords and SSH private keys are never sent to any AI provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーはデバイスのキーチェーンにのみ保存されます。サーバーパスワードや SSH 秘密鍵が AI プロバイダに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 기기의 키체인에만 저장됩니다. 서버 비밀번호와 SSH 개인 키는 어떤 AI 공급자에게도 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 仅保存在本机钥匙串中。服务器密码和 SSH 私钥绝不会发送给任何 AI 服务商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 僅儲存在本機鑰匙圈中。伺服器密碼與 SSH 私鑰絕不會傳送給任何 AI 服務商。"
          }
        }
      }
    },
