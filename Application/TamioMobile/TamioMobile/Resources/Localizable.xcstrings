    "Find top CPU and memory consuming processes, swap usage, and zombie processes across my servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find top CPU and memory consuming processes, swap usage, and zombie processes across my servers."
          }
