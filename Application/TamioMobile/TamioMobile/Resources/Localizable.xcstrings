        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 호스팅한 iGhostVT 릴레이 서버의 .vtrpsc 파일을 가져오면 외부 네트워크에서도 페어링된 기기에 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
