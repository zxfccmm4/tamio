    },
    "Earlier turns were condensed to fit the context window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier turns were condensed to fit the context window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキスト長に合わせて過去のやり取りを要約しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트 창에 맞게 이전 대화가 요약되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较早轮次已自动摘要以适配上下文窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較早輪次已自動摘要以適配上下文視窗。"
          }
        }
      }
    },
    "Ed25519, RSA and ECDSA keys work, in OpenSSH or PEM format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ed25519, RSA and ECDSA keys work, in OpenSSH or PEM format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH または PEM 形式の Ed25519・RSA・ECDSA 鍵に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 또는 PEM 형식의 Ed25519, RSA, ECDSA 키를 지원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 OpenSSH 或 PEM 格式的 Ed25519、RSA 与 ECDSA 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 OpenSSH 或 PEM 格式的 Ed25519、RSA 與 ECDSA 金鑰。"
