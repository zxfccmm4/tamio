            "state": "translated",
            "value": "サーバー側へのエージェント導入不要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 측 에이전트 설치 불필요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
