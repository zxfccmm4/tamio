          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트는 1에서 65535 사이의 숫자여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口必须是 1 到 65535 之间的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠必須是 1 到 65535 之間的數字。"
          }
        }
      }
    },
    "Powered by the native Ghostty terminal engine with full truecolor, Nerd Fonts, themes, scrollback search, interaction lock, customizable touch keyboard bar, and Live Activities.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于原生 Ghostty 终端引擎，完整支持真彩色、Nerd Fonts、多主题、回滚搜索、交互锁、自定义触控键盘栏与实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於原生 Ghostty 終端引擎，完整支援真彩色、Nerd Fonts、多主題、回捲搜尋、互動鎖、自訂觸控鍵盤列與即時動態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ Ghostty エンジンを搭載し、トゥルーカラー・Nerd Fonts・テーマ・検索・ロック・カスタムキーボードバー・ライブアクティビティに対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 Ghostty 엔진을 기반으로 트루컬러, Nerd Fonts, 테마, 스크롤백 검색, 잠금, 맞춤 키보드 바 및 실시간 현황을 지원합니다."
          }
        }
      }
    },
