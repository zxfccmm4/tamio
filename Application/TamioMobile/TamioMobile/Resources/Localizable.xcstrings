          "stringUnit": {
            "state": "translated",
            "value": "Apple Private Cloud Compute は一時的に利用できません。しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 비공개 클라우드 컴퓨팅을 일시적으로 사용할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 私有云计算暂时不可用，请稍后重试。"
