    "The key each server presents on its next connection is saved as its key.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key each server presents on its next connection is saved as its key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サーバーが次回の接続時に提示する鍵が、そのホスト鍵として保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 서버가 다음 연결 시 제시하는 키가 해당 호스트 키로 저장됩니다."
          }
        },
        "zh-Hans": {
