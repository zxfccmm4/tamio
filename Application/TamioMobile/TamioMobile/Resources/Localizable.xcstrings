        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの開放ポート、SSH 認証ポリシー、最近の失敗したログイン試行を監査します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 열린 수신 포트, SSH 인증 정책 및 최근 실패한 로그인 시도를 감사하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审计所有服务器的开放监听端口、SSH 认证策略与近期失败的登录尝试。"
