    "SSH, SFTP, and server monitoring traffic goes directly from your device to your servers with no relay or third-party proxy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH, SFTP, and server monitoring traffic goes directly from your device to your servers with no relay or third-party proxy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH・SFTP・監視トラフィックはデバイスからサーバーへ直接接続され、第三者の中継を経由しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH, SFTP 및 서버 모니터링 트래픽은 제3자 중계 없이 기기에서 서버로 직접 연결됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH、SFTP 与服务器监控流量均由你的设备直连目标服务器，不经过任何第三方中转服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH、SFTP 與伺服器監控流量均由你的裝置直連目標伺服器，不經過任何第三方中轉伺服器。"
          }
        }
      }
    },
