    "Exports an AES-256-GCM encrypted backup file you can AirDrop or save to Files for importing on another device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports an AES-256-GCM encrypted backup file you can AirDrop or save to Files for importing on another device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM で暗号化されたバックアップを書き出します。AirDrop や「ファイル」で別デバイスへ移行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256-GCM으로 암호화된 백업 파일을 내보내 AirDrop이나 파일 앱으로 다른 기기에 가져올 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出经 AES-256-GCM 加密的备份文件，可通过隔空投送（AirDrop）或“文件”传输到其他设备导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出經 AES-256-GCM 加密的備份檔案，可透過 AirDrop 或「檔案」傳輸至其他裝置匯入。"
          }
        }
      }
    },
