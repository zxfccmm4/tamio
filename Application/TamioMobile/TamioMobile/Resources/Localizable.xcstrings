    "This identity uses an SSH agent on macOS. iOS cannot connect to external SSH agents; its configuration is kept intact so Mac sync continues working.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identity uses an SSH agent on macOS. iOS cannot connect to external SSH agents; its configuration is kept intact so Mac sync continues working."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この認証情報は macOS の SSH エージェントを使用します。iOS では接続できませんが、Mac 同期のため設定を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자격 증명은 macOS SSH 에이전트를 사용합니다. iOS에서는 연결할 수 없으나 Mac 동기화를 위해 설정을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此凭据在 macOS 上使用 SSH Agent。iOS 无法连接外部 SSH Agent，已完整保留配置以确保 Mac 同步不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此憑證在 macOS 上使用 SSH Agent。iOS 無法連線外部 SSH Agent，已完整保留設定以確保 Mac 同步不受影響。"
          }
        }
      }
    },
    "This key is held by a macOS SSH agent and cannot be used directly on iOS. Choose a stored key to connect from this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key is held by a macOS SSH agent and cannot be used directly on iOS. Choose a stored key to connect from this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この鍵は macOS の SSH エージェントが管理しているため iOS では直接使用できません。保存済みの鍵を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 macOS SSH 에이전트가 관리하므로 iOS에서 직접 사용할 수 없습니다. 저장된 키를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥由 macOS SSH Agent 托管，无法在 iOS 上直接使用。请选择本地保存的密钥从此设备连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此金鑰由 macOS SSH Agent 託管，無法在 iOS 上直接使用。請選擇本機儲存的金鑰從此裝置連線。"
          }
        }
      }
    },
    "This permanently deletes all saved AI chat histories on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes all saved AI chat histories on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されたすべての AI 会話履歴が完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장된 모든 AI 대화 기록이 영구적으로 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将永久删除本机保存的全部 AI 聊天记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將永久刪除本機儲存的全部 AI 聊天記錄。"
          }
        }
      }
    },
    "This private key uses an algorithm Tamio does not support.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This private key uses an algorithm Tamio does not support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この秘密鍵は Tamio でサポートされていないアルゴリズムを使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개인 키는 Tamio에서 지원하지 않는 알고리즘을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此私钥使用 Tamio 不支持的算法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此私鑰使用了 Tamio 不支援的演算法。"
          }
        }
      }
    },
    "This proxy command uses tokens Tamio does not support. Only %h, %p and %% are supported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proxy command uses tokens Tamio does not support. Only %h, %p and %% are supported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロキシコマンドには Tamio でサポートされていないトークンが含まれています。%h、%p、%% のみサポートされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프록시 명령에는 Tamio에서 지원하지 않는 토큰이 포함되어 있습니다. %h, %p, %%만 지원됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理命令使用了 Tamio 不支持的标记。仅支持 %h、%p 和 %%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理命令使用了 Tamio 不支援的標記。僅支援 %h、%p 和 %%。"
          }
        }
      }
    },
    "This proxy runs a local command when connecting. It depends on local OpenSSH configuration, programs and keys; jump-host trust is managed separately from Tamio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proxy runs a local command when connecting. It depends on local OpenSSH configuration, programs and keys; jump-host trust is managed separately from Tamio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロキシは接続時にローカルコマンドを実行します。ローカルの OpenSSH 設定、プログラム、鍵に依存し、踏み台サーバーの信頼は Tamio とは別に管理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프록시는 연결 시 로컬 명령을 실행합니다. 로컬 OpenSSH 구성, 프로그램 및 키에 의존하며, 점프 호스트 신뢰는 Tamio와 별도로 관리됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理在连接时运行本地命令。它依赖本机 OpenSSH 配置、程序和密钥；跳板机信任由 OpenSSH 管理，与 Tamio 分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理會在連線時執行本機命令。它依賴本機 OpenSSH 設定、程式與金鑰；跳板機信任由 OpenSSH 管理，與 Tamio 分開。"
          }
        }
      }
    },
    "This relay configuration file is damaged or missing required fields.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay configuration file is damaged or missing required fields."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリレー設定ファイルは破損しているか、必須項目が不足しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
