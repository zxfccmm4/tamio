    "Signs in as %@ with no password or key, for a server that trusts the connection itself, such as Tailscale SSH.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs in as %@ with no password or key, for a server that trusts the connection itself, such as Tailscale SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードや鍵なしで %@ としてサインインします（Tailscale SSH など接続自体を信頼するサーバー向け）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호나 키 없이 %@(으)로 로그인합니다(Tailscale SSH 등 연결 자체를 신뢰하는 서버용)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 无密码/密钥直接登录，适用于信任连接本身的服务器（如 Tailscale SSH）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 無密碼/金鑰直接登入，適用於信任連線本身的伺服器（如 Tailscale SSH）。"
          }
        }
      }
    },
