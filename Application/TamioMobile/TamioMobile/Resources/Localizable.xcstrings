    "    If the server was edited, open a new terminal instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "    If the server was edited, open a new terminal instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "    サーバー設定を変更した場合は、新しいターミナルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "    서버 설정을 수정한 경우 새 터미널을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "    如果服务器已修改，请改为打开新终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "    如果伺服器資訊已修改，請新開一個終端視窗。"
          }
        }
      }
    },
