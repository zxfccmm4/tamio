    "Run a fleet health check across my servers: summarize CPU, memory, disk usage, load average, and flag any anomalies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a fleet health check across my servers: summarize CPU, memory, disk usage, load average, and flag any anomalies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全サーバーのヘルスチェックを実行し、CPU・メモリ・ディスク・負荷を要約して異常を指摘します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 상태 점검을 실행하여 CPU, 메모리, 디스크 사용량, 평균 부하를 요약하고 이상 항목을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有服务器执行健康巡检：汇总 CPU、内存、磁盘使用率与系统负载，并标出所有异常项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對所有伺服器執行健康巡檢：彙總 CPU、記憶體、磁碟使用率與系統負載，並標出所有異常項。"
          }
        }
      }
    },
    "Run in SSH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run in SSH"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH で実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH에서 실행"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 SSH 中执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 SSH 中執行"
          }
        }
      }
    },
    "Run network diagnostics across my servers: check TCP socket states, interface packet drops, and DNS resolvers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run network diagnostics across my servers: check TCP socket states, interface packet drops, and DNS resolvers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全サーバーのネットワーク診断を実行し、TCP ソケット状態・パケットドロップ・DNS 設定を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 네트워크 진단을 실행하여 TCP 소켓 상태, 인터페이스 패킷 손실 및 DNS 확인자를 점검합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有服务器执行网络诊断：检查 TCP 套接字状态、网卡丢包情况与 DNS 解析配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對所有伺服器執行網路診斷：檢查 TCP 通訊端狀態、網卡封包遺失情況與 DNS 解析設定。"
          }
        }
      }
    },
