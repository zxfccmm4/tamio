    },
    "Built directly on Tamio's MCP tool engine with Apple Intelligence, OpenAI, Claude, Gemini, DeepSeek, Ollama, and 14 built-in ops skills to audit and manage servers in parallel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 Tamio MCP 工具引擎，支持 Apple Intelligence、OpenAI、Claude、Gemini、DeepSeek、Ollama 及 14 项内置运维技能并行巡检与管理服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 Tamio MCP 工具引擎，支援 Apple Intelligence、OpenAI、Claude、Gemini、DeepSeek、Ollama 及 14 項內建維運技能並行巡檢與管理伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio の MCP エンジン上に構築され、Apple Intelligence・OpenAI・Claude・Gemini・DeepSeek・Ollama と 14 の運用スキルでサーバーを並列管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio의 MCP 엔진을 기반으로 Apple Intelligence, OpenAI, Claude, Gemini, DeepSeek, Ollama 및 14개 내장 운영 스킬로 서버를 병렬 관리합니다."
          }
        }
      }
    },
