    "Tamio uses its own connection and host-trust policy; these OpenSSH settings are not imported: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio uses its own connection and host-trust policy; these OpenSSH settings are not imported: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio は独自の接続・ホスト信頼ポリシーを使用するため、次の OpenSSH 設定はインポートされません：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio는 자체 연결 및 호스트 신뢰 정책을 사용하므로 다음 OpenSSH 설정은 가져오지 않습니다: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 使用独立的连接和主机信任策略；不会导入以下 OpenSSH 设置：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio 使用獨立的連線與主機信任原則；不會匯入以下 OpenSSH 設定：%@。"
          }
        }
      }
    },
