    "Signs in as %@ with no password or key, for a server that trusts the connection itself, such as Tailscale SSH.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs in as %@ with no password or key, for a server that trusts the connection itself, such as Tailscale SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードや鍵なしで %@ としてサインインします（Tailscale SSH など接続自体を信頼するサーバー向け）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호나 키 없이 %@(으)로 로그인합니다(Tailscale SSH 등 연결 자체를 신뢰하는 서버용)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 无密码/密钥直接登录，适用于信任连接本身的服务器（如 Tailscale SSH）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 無密碼/金鑰直接登入，適用於信任連線本身的伺服器（如 Tailscale SSH）。"
          }
        }
      }
    },
    "Signs in as %@. The key is kept in Identities, for other servers too.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs in as %@. The key is kept in Identities, for other servers too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ としてサインインします。鍵は「認証情報」に保存され、他のサーバーでも使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 사용자로 로그인합니다. 키는 자격 증명에 보관되며 다른 서버에서도 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 身份登录。密钥保存在“身份凭据”中，其他服务器也可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %@ 身分登入。金鑰將儲存在「身分憑證」中，其他伺服器也可使用。"
          }
        }
      }
    },
    "Signs in with the agent's key for this host. Nothing private is copied into Tamio.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
