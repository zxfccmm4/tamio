        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 iCloud 中的数据。请用此设备的数据替换后继续。"
          }
        }
      }
    },
    "What is in iCloud is replaced with this device's servers and identities, encrypted with the new passphrase. Your other devices will ask for it.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is in iCloud is replaced with this device's servers and identities, encrypted with the new passphrase. Your other devices will ask for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 中的数据将被替换为此设备的服务器和身份凭据，并用新口令加密。你的其他设备会要求输入新口令。"
          }
        }
      }
    },
    "What is in iCloud was written by a newer version of Tamio. Update Tamio on this device.": {
      "extractionState": "stale",
