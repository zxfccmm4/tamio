    "Audit crontabs and systemd timers across my servers and highlight any broken or suspicious scheduled jobs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit crontabs and systemd timers across my servers and highlight any broken or suspicious scheduled jobs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの crontab と systemd タイマーを監査し、壊れたまたは不審なジョブを特定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 crontab 및 systemd 타이머를 감사하고 손상되었거나 의심스러운 예약 작업을 강조 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审计所有服务器的 crontab 与 systemd 定时任务，并标出异常或可疑的计划任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稽核所有伺服器的 crontab 與 systemd 定時任務，並標出異常或可疑的排程任務。"
          }
        }
      }
    },
    "Audit listening ports and failed SSH logins": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit listening ports and failed SSH logins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスニングポートと SSH ログイン失敗を監査"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 대기 포트 및 SSH 로그인 실패 감사"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查监听端口、SSH 登录策略与暴力破解失败记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查監聽埠、SSH 登入策略與暴力破解失敗記錄"
          }
        }
      }
    },
    "Audit listening ports, SSH authentication policy, root login, sudoers, and recent failed SSH logins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit listening ports, SSH authentication policy, root login, sudoers, and recent failed SSH logins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待受ポート、SSH 認証ポリシー、root ログイン、sudoers、最近の失敗した SSH ログインを監査します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 대기 포트, SSH 인증 정책, root 로그인, sudoers 및 최근 실패한 SSH 로그인을 감사하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审计监听端口、SSH 认证策略、root 登录、sudoers 配置及近期失败的 SSH 登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稽核監聽連接埠、SSH 認證策略、root 登入、sudoers 設定及近期失敗的 SSH 登入。"
          }
        }
      }
    },
    "Audit open listening ports, SSH authentication policy, and recent failed login attempts across my servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audit open listening ports, SSH authentication policy, and recent failed login attempts across my servers."
