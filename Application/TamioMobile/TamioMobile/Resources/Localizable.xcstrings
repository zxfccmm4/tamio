    "%@ could not sign in to %@ with this password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not sign in to %@ with this password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのパスワードで %@ にサインインできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 암호로 %@에 로그인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法使用此密码登录到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法使用此密碼登入 %@。"
          }
        }
      }
    },
    "%@ did not accept this key for %@. Add its public key to ~/.ssh/authorized_keys there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not accept this key for %@. Add its public key to ~/.ssh/authorized_keys there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ 用のこの鍵を受け入れませんでした。公開鍵をサーバーの ~/.ssh/authorized_keys に追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 %@의 이 키를 거부했습니다. 공개 키를 서버의 ~/.ssh/authorized_keys에 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了用户 %@ 的此密钥。请将其公钥添加到服务器的 ~/.ssh/authorized_keys。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了使用者 %@ 的此金鑰。請將其公鑰加入伺服器的 ~/.ssh/authorized_keys。"
          }
        }
      }
    },
    "%@ did not let %@ in without a password or key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not let %@ in without a password or key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はパスワードや鍵なしでの %@ のサインインを許可しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 암호나 키 없이 %@의 로그인을 허용하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不允许 %@ 在无密码/密钥的情况下登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不允許 %@ 在無密碼/金鑰的情況下登入。"
          }
        }
      }
    },
    "%@ does not offer SFTP.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not offer SFTP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は SFTP を提供していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) SFTP를 제공하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供 SFTP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供 SFTP 服務。"
          }
        }
      }
    },
    "%@ does not offer SFTP. Enable its sftp subsystem in sshd_config.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not offer SFTP. Enable its sftp subsystem in sshd_config."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は SFTP を提供していません。sshd_config で sftp サブシステムを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) SFTP를 제공하지 않습니다. sshd_config에서 sftp 하위 시스템을 활성화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供 SFTP。请在 sshd_config 中启用其 sftp 子系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供 SFTP 服務。請在 sshd_config 中啟用其 sftp 子系統。"
          }
        }
      }
    },
