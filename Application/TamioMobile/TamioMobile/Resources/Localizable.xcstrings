        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーで CPU・メモリ消費上位のプロセス、スワップ使用率、ゾンビプロセスを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버에서 CPU 및 메모리 사용량 상위 프로세스, 스왑 사용량 및 좀비 프로세스를 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找所有服务器中占用最高 CPU 和内存的进程、Swap 占用与僵尸进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找所有伺服器中佔用最高 CPU 和記憶體的程序、Swap 佔用與殭屍程序。"
          }
        }
      }
    },
