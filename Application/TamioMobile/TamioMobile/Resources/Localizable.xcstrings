    "The Mac's SSH configuration at %@ could not be inspected, so its defaults are not applied: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac's SSH configuration at %@ could not be inspected, so its defaults are not applied: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の %@ にある SSH 設定を検査できなかったため、デフォルト設定は適用されません：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 %@에 있는 SSH 구성을 검사할 수 없어 기본값이 적용되지 않았습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
