    "%@ was modified on the server after you opened it. Overwrite it with your changes, or reload the latest remote version?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was modified on the server after you opened it. Overwrite it with your changes, or reload the latest remote version?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は開いた後にサーバー上で変更されました。変更内容で上書きしますか、それとも最新のリモート版を再読み込みしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 파일이 열린 이후 서버에서 수정되었습니다. 변경 내용으로 덮어쓸까요, 아니면 최신 원격 버전을 다시 불러올까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”在你打开后已在服务器上被修改。要使用你的修改覆盖它，还是重新加载最新远端版本？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在你開啟後已在伺服器上被修改。要使用你的修改覆寫它，還是重新載入最新遠端版本？"
          }
        }
      }
    },
