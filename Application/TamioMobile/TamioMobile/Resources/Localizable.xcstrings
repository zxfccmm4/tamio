    "Choose a .tamiobackup.json file exported from another device. You can preview all items and choose Merge or Replace before applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a .tamiobackup.json file exported from another device. You can preview all items and choose Merge or Replace before applying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別デバイスから書き出した .tamiobackup.json を選択してください。適用前に内容をプレビューし、マージまたは置換を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 내보낸 .tamiobackup.json 파일을 선택하세요. 적용 전에 내용을 미리 보고 병합 또는 덮어쓰기를 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择从其他设备导出的 .tamiobackup.json 文件，导入前可预览全部条目并选择“合并”或“完全覆盖”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
