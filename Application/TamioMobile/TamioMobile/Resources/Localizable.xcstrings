          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次執行命令"
          }
        }
      }
    },
    "Run network diagnostics across my servers: check TCP socket states, interface packet drops, and DNS resolvers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有服务器执行网络诊断：检查 TCP 套接字状态、网卡丢包情况与 DNS 解析配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對所有伺服器執行網路診斷：檢查 TCP 通訊端狀態、網卡封包遺失情況與 DNS 解析設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全サーバーのネットワーク診断を実行し、TCP ソケット状態・パケットドロップ・DNS 設定を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 네트워크 진단을 실행하여 TCP 소켓 상태, 인터페이스 패킷 손실 및 DNS 확인자를 점검합니다."
          }
        }
      }
    },
