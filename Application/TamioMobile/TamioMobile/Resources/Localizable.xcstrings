    "Actively developed on top of missuo/tamio with non-jailbreak iGhostVT mobile terminal ergonomics, Apple Shortcuts, and Live Activities.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actively developed on top of missuo/tamio with non-jailbreak iGhostVT mobile terminal ergonomics, Apple Shortcuts, and Live Activities."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "missuo/tamio をベースに開発され、非脱獄版 iGhostVT のモバイル端末体験、Apple ショートカット、ライブアクティビティを統合しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "missuo/tamio를 기반으로 개발되었으며, 비탈옥 iGhostVT 모바일 터미널 UX, Apple 단축어 및 실시간 현황(Live Activities)을 통합했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 missuo/tamio 持续二次开发，融合非越狱 iGhostVT 移动端终端体验、Apple 快捷指令与实时活动（Live Activities）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 missuo/tamio 持續二次開發，融合非越獄 iGhostVT 行動端終端機體驗、Apple 捷徑與即時動態（Live Activities）。"
          }
        }
      }
    },
