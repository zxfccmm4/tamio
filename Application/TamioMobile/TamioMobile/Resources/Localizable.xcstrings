    "The servers' keys: one trusted on a device is trusted on the others.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The servers' keys: one trusted on a device is trusted on the others."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの鍵：1 台のデバイスで信頼すると、他のデバイスでも信頼されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 키: 한 기기에서 신뢰하면 다른 기기에서도 신뢰됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
