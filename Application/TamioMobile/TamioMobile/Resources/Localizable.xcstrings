    "Optional iCloud Sync encrypts your server inventory end-to-end before storing it in your private Apple iCloud account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional iCloud Sync encrypts your server inventory end-to-end before storing it in your private Apple iCloud account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の iCloud 同期では、デバイス上でエンドツーエンド暗号化した後に個人の iCloud に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 iCloud 동기화는 기기에서 종단간 암호화한 후 개인 Apple iCloud 계정에 저장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的 iCloud 同步会在本机完成端到端加密后，再写入你的个人 Apple iCloud 账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的 iCloud 同步會在本機完成端對端加密後，再寫入你的個人 Apple iCloud 帳戶。"
          }
        }
      }
    },
    "Optional. Also unlocks the private key.": {
