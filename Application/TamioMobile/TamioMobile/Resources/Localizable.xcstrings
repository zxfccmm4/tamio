    "Check Docker containers across my servers and highlight any exited, restarting, or unhealthy containers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Docker containers across my servers and highlight any exited, restarting, or unhealthy containers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの Docker コンテナを確認し、停止・再起動中・異常なコンテナを一覧表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 Docker 컨테이너를 확인하고 종료됨, 재시작 중 또는 비정상 컨테이너를 강조 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 Docker 容器，并高亮已退出、反复重启或不健康的容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器的 Docker 容器，並突顯已結束、反覆重啟或不健康的容器。"
          }
        }
      }
    },
    "Check Nginx and Caddy status, config validity, and recent error logs across my servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Nginx and Caddy status, config validity, and recent error logs across my servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの Nginx / Caddy の状態、設定検証、最近のエラーログを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 Nginx 및 Caddy 상태, 구성 유효성 및 최근 오류 로그를 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 Nginx 与 Caddy 运行状态、配置合法性及近期错误日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
