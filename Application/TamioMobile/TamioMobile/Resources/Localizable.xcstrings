    },
    "This does not look like a private key. Load it anyway?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not look like a private key. Load it anyway?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵ではないようです。このまま読み込みますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키 형식이 아닌 것 같습니다. 그래도 불러오시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不像私钥内容，仍要载入吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不像私鑰內容，仍要載入嗎？"
          }
        }
      }
    },
    "This does not look like a private key: it starts with -----BEGIN … PRIVATE KEY----- or PuTTY-User-Key-File.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not look like a private key: it starts with -----BEGIN … PRIVATE KEY----- or PuTTY-User-Key-File."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵の形式ではありません。-----BEGIN … PRIVATE KEY----- または PuTTY-User-Key-File で始まる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키 형식이 아닙니다. -----BEGIN … PRIVATE KEY----- 또는 PuTTY-User-Key-File로 시작해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不像私钥：私钥应以 -----BEGIN … PRIVATE KEY----- 或 PuTTY-User-Key-File 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不像私鑰：私鑰應以 -----BEGIN … PRIVATE KEY----- 或 PuTTY-User-Key-File 開頭。"
          }
        }
      }
    },
    "This does not look like a private key: it starts with -----BEGIN … PRIVATE KEY-----.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not look like a private key: it starts with -----BEGIN … PRIVATE KEY-----."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵の形式ではありません。-----BEGIN … PRIVATE KEY----- で始まる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 개인 키 형식이 아닙니다. -----BEGIN … PRIVATE KEY-----로 시작해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不像有效的私钥：私钥应以 -----BEGIN … PRIVATE KEY----- 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不像有效的私鑰：私鑰應以 -----BEGIN … PRIVATE KEY----- 開頭。"
          }
        }
      }
    },
    "This file changed on the server after you opened it. Reload the remote version or overwrite it anyway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file changed on the server after you opened it. Reload the remote version or overwrite it anyway."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは開いた後にサーバー上で変更されました。リモート版を再読み込みするか、そのまま上書きしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 연 뒤 서버에서 내용이 변경되었습니다. 원격 버전을 다시 불러오거나 강제로 덮어쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件在你打开后已在服务器上被修改。请重新加载远端版本，或选择强制覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案在你開啟後已在伺服器上被修改。請重新載入遠端版本，或選擇強制覆寫。"
          }
        }
      }
    },
    "This file is %@; files up to %@ open in the editor. Download it instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is %@; files up to %@ open in the editor. Download it instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルのサイズは %@ です。エディタで開けるのは %@ までのファイルです。ダウンロードして確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일 크기는 %@입니다. 편집기에서는 최대 %@까지의 파일만 열 수 있습니다. 대신 다운로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件大小为 %@；编辑器最多打开 %@ 的文件。请下载后查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案大小為 %@；編輯器最多只能開啟 %@ 的檔案。請改為下載。"
          }
        }
      }
    },
