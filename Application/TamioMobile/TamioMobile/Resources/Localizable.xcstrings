          }
        }
      }
    },
    "Check PostgreSQL, MySQL, and Redis health, active connections, memory usage, and recent backup files across my servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check PostgreSQL, MySQL, and Redis health, active connections, memory usage, and recent backup files across my servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの PostgreSQL・MySQL・Redis の健全性、接続数、メモリ使用量、最新バックアップを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 PostgreSQL, MySQL, Redis 상태, 활성 연결, 메모리 사용량 및 최근 백업 파일을 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 PostgreSQL、MySQL 与 Redis 健康状态、活跃连接、内存占用及近期备份文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器的 PostgreSQL、MySQL 與 Redis 健康狀態、活躍連線、記憶體佔用及近期備份檔案。"
          }
        }
      }
    },
    "Check PostgreSQL, MySQL/MariaDB, and Redis service health, active connections, memory, and backup freshness.": {
      "localizations": {
