    "Batch-check Let's Encrypt, Nginx, and Caddy TLS certificate expiration dates and auto-renewal timers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch-check Let's Encrypt, Nginx, and Caddy TLS certificate expiration dates and auto-renewal timers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's Encrypt・Nginx・Caddy の証明書期限と自動更新タイマーを一括確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's Encrypt, Nginx 및 Caddy TLS 인증서 만료일과 자동 갱신 타이머를 일괄 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量检查 Let's Encrypt、Nginx 与 Caddy 证书剩余有效期及自动续签定时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次檢查 Let's Encrypt、Nginx 與 Caddy 憑證剩餘有效期及自動續簽排程。"
          }
        }
      }
    },
    "Batch-inspect disk usage, large directories, systemd journal size, and Docker reclaimable space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch-inspect disk usage, large directories, systemd journal size, and Docker reclaimable space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク使用量、大容量ディレクトリ、systemd ジャーナルサイズ、Docker の回収可能容量を一括点検します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 사용량, 대용량 디렉터리, systemd 저널 크기 및 Docker 회수 가능 공간을 일괄 점검합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量巡检磁盘占用、大体积目录、systemd 日志大小与 Docker 可回收空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次巡檢磁碟佔用、大體積目錄、systemd 日誌大小與 Docker 可回收空間。"
          }
        }
      }
    },
