    },
    "Apple Private Cloud Compute usage limit reached. Try again later or switch to On-Device / another provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Private Cloud Compute usage limit reached. Try again later or switch to On-Device / another provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Private Cloud Compute の利用上限に達しました。しばらくしてから再試行するか、オンデバイスまたは別のプロバイダーに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 비공개 클라우드 컴퓨팅 사용 한도에 도달했습니다. 나중에 다시 시도하거나 온디바이스 또는 다른 제공업체로 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到 Apple 私有云计算的使用配额，请稍后再试或切换至端侧模型/其他 AI 服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達到 Apple 私有雲端運算的使用配額，請稍後再試或切換至裝置端模型/其他 AI 服務。"
          }
        }
      }
