          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않으면 변경 내용이 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不保存，您的更改将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不儲存，您的變更將會遺失。"
          }
        }
      }
    },
    "Your other devices take it from iCloud Keychain, or ask for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices take it from iCloud Keychain, or ask for it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスでは iCloud キーチェーンから取得するか、入力を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서는 iCloud 키체인에서 가져오거나 입력을 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他设备会从 iCloud 钥匙串获取它，或要求你输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他裝置會從 iCloud 鑰匙圈取得，或要求你輸入。"
          }
        }
      }
    },
    "Your servers and identities stay on this device. A device that still syncs will store its own again, so turn sync off there too.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your servers and identities stay on this device. A device that still syncs will store its own again, so turn sync off there too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器和身份凭据会保留在此设备上。仍在同步的设备会重新存储它自己的数据，因此也请在那里关闭同步。"
          }
        }
      }
    },
    "Zero server-side agent installation required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero server-side agent installation required"
          }
        },
        "ja": {
