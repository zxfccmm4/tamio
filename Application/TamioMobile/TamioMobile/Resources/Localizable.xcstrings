    "Help me inspect disk usage, large log directories, and top memory processes on this server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me inspect disk usage, large log directories, and top memory processes on this server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのディスク使用状況、サイズの大きいログディレクトリ、メモリ消費上位のプロセスを調べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 디스크 사용량, 대용량 로그 디렉터리 및 메모리 사용량 상위 프로세스를 점검해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我检查此服务器上的磁盘使用情况、大型日志目录以及内存占用最高的进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫我檢查此伺服器上的磁碟使用情況、大型日誌目錄以及記憶體佔用最高的程序。"
          }
        }
      }
    },
