    "iCloud already holds data from one of your devices. Enter the passphrase you chose there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud already holds data from one of your devices. Enter the passphrase you chose there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud にはすでに別のデバイスのデータがあります。そのデバイスで設定したパスフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 이미 다른 기기의 데이터가 있습니다. 해당 기기에서 설정한 암호 구문을 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 中已有来自你某台设备的数据。请输入你在那台设备上设置的口令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 中已有來自你某部裝置的資料。請輸入你在該裝置上設定的密碼片語。"
          }
        }
      }
    },
    "iOS apps cannot spawn external proxy commands. Preserved for Mac sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS apps cannot spawn external proxy commands. Preserved for Mac sync."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS では外部プロキシコマンドを実行できません。Mac 同期のため設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 외부 프록시 명령을 실행할 수 없습니다. Mac 동기화를 위해 설정은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法执行外部代理命令，已原样保留以便与 Mac 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法執行外部代理指令，已原樣保留以便與 Mac 同步。"
          }
        }
      }
    },
