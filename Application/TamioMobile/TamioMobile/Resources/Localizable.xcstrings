    "Check Nginx and Caddy status, config validity, and recent error logs across my servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 Nginx 与 Caddy 运行状态、配置合法性及近期错误日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器的 Nginx 與 Caddy 執行狀態、設定合法性及近期錯誤日誌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの Nginx / Caddy の状態、設定検証、最近のエラーログを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 Nginx 및 Caddy 상태, 구성 유효성 및 최근 오류 로그를 확인합니다."
          }
        }
      }
    },
    "Check now": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查"
          }
        }
      }
    },
    "Check pending package and security updates and see which servers require a reboot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查待安装的软件包与安全更新，并列出需要重启的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查待安裝的套件與安全更新，並列出需要重啟的伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のパッケージ・セキュリティ更新を確認し、再起動が必要なサーバーを特定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 패키지 및 보안 업데이트를 확인하고 재부팅이 필요한 서버를 파악합니다."
          }
        }
      }
    },
    "Check PostgreSQL, MySQL, and Redis health, active connections, memory usage, and recent backup files across my servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 PostgreSQL、MySQL 与 Redis 健康状态、活跃连接、内存占用及近期备份文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器的 PostgreSQL、MySQL 與 Redis 健康狀態、活躍連線、記憶體佔用及近期備份檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの PostgreSQL・MySQL・Redis の健全性、接続数、メモリ使用量、最新バックアップを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서버의 PostgreSQL, MySQL, Redis 상태, 활성 연결, 메모리 사용량 및 최근 백업 파일을 확인합니다."
          }
        }
      }
    },
    "Check PostgreSQL, MySQL/MariaDB, and Redis service health, active connections, memory, and backup freshness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check PostgreSQL, MySQL/MariaDB, and Redis service health, active connections, memory, and backup freshness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PostgreSQL・MySQL/MariaDB・Redis の稼働、接続数、メモリ、バックアップ鮮度を確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PostgreSQL, MySQL/MariaDB 및 Redis 상태, 연결 수, 메모리, 백업 최신성을 점검합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量检查 PostgreSQL、MySQL/MariaDB 与 Redis 状态、连接数、内存与备份时效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次檢查 PostgreSQL、MySQL/MariaDB 與 Redis 狀態、連線數、記憶體與備份時效。"
          }
        }
      }
    },
    "Check running, exited, and unhealthy Docker containers plus per-container CPU and memory across servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器中运行中、已退出和不健康的 Docker 容器，以及各容器的 CPU 与内存占用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器中執行中、已結束和不健康的 Docker 容器，以及各容器的 CPU 與記憶體佔用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サーバーの稼働中・停止・異常な Docker コンテナとコンテナ別の CPU・メモリ使用量を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 전반의 실행 중, 종료됨, 비정상 Docker 컨테이너 및 컨테이너별 CPU/메모리를 확인합니다."
          }
        }
      }
    },
