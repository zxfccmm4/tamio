          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio の暗号化キーがロックされている間はインポートできません。キーチェーンのロックを解除してから Tamio を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
