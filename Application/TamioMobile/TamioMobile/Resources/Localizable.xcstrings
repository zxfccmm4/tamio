    "OpenSSH could not resolve this host. Check the configuration for invalid or unsupported settings.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH could not resolve this host. Check the configuration for invalid or unsupported settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH はこのホストを解決できませんでした。無効または未対応の設定がないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH가 이 호스트를 확인할 수 없습니다. 잘못되었거나 지원되지 않는 설정이 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 无法解析此主机。请检查配置中无效或不支持的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 無法解析此主機。請檢查設定中是否有無效或不支援的項目。"
          }
        }
      }
    },
    "OpenSSH did not resolve a valid host, port and user.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH did not resolve a valid host, port and user."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH は有効なホスト、ポート、およびユーザーを解決できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH가 유효한 호스트, 포트 및 사용자를 확인하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 未解析出有效的主机、端口和用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 未能解析出有效的主機、連接埠與使用者。"
          }
        }
      }
    },
    "OpenSSH did not return a usable host, username, and port.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH did not return a usable host, username, and port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH は使用可能なホスト、ユーザー名、およびポートを返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
