    "Inspect TCP socket states (TIME_WAIT/CLOSE_WAIT), NIC packet drops, DNS resolution, and outbound latency.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect TCP socket states (TIME_WAIT/CLOSE_WAIT), NIC packet drops, DNS resolution, and outbound latency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP ソケット状態、NIC パケットドロップ、DNS 設定を診断。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TCP 소켓 상태(TIME_WAIT/CLOSE_WAIT), NIC 패킷 손실 및 DNS 구성을 진단합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排查 TCP 连接状态（TIME_WAIT / CLOSE_WAIT）、网卡丢包与 DNS 解析配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排查 TCP 連線狀態（TIME_WAIT / CLOSE_WAIT）、網卡封包遺失與 DNS 解析設定。"
          }
        }
      }
    },
    "Inspect ufw, firewalld, nftables, or iptables rules and cross-check against public listening sockets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect ufw, firewalld, nftables, or iptables rules and cross-check against public listening sockets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ufw / firewalld / nftables / iptables ルールと公開リッスンポートを照合。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ufw / firewalld / nftables / iptables 규칙을 점검하고 공개 수신 포트와 대조합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 ufw / firewalld / nftables / iptables 规则并核对公网暴露端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查 ufw / firewalld / nftables / iptables 規則並核對公網暴露連接埠。"
          }
        }
      }
    },
