    "Credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證"
          }
        }
      }
    },
    "Credentials are encrypted on device and stored in Apple Keychain. Protect sessions with Face ID / Passcode lock, app-switcher blur, and strict SSH host key verification.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证在本机加密并存放于 Apple 钥匙串，提供面容 ID / 密码锁、后台切换模糊与严格的 SSH 主机密钥校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證在本機加密並存放於 Apple 鑰匙圈，提供 Face ID / 密碼鎖、背景切換模糊與嚴格的 SSH 主機金鑰校驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報は端末内で暗号化され Apple キーチェーンに保存されます。Face ID ロック、画面ぼかし、厳格なホスト鍵検証で保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명은 기기에서 암호화되어 Apple 키체인에 저장됩니다. Face ID 잠금, 앱 전환기 블러 및 엄격한 SSH 호스트 키 검증을 제공합니다."
          }
        }
      }
    },
    "Credentials stay on your device or in your end-to-end encrypted iCloud.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報はお使いのデバイスまたはエンドツーエンド暗号化された iCloud にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명은 기기 또는 종단 간 암호화된 iCloud에만 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有凭证仅保存在本机或您的端到端加密 iCloud 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有憑證僅保存在本機或您的端對端加密 iCloud 中。"
          }
        }
      }
    },
