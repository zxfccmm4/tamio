    "Check TLS/SSL certificate expiration dates and auto-renewal timers across my servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查所有服务器的 TLS/SSL 证书到期时间与自动续期定时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查所有伺服器的 TLS/SSL 憑證到期時間與自動續期定時器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーの TLS/SSL 証明書の有効期限と自動更新タイマーを確認します。"
          }
        },
        "ko": {
