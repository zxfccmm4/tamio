    "Browse remote filesystems alongside local Files documents, edit server configs with syntax highlighting, and queue concurrent uploads and downloads with conflict handling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse remote filesystems alongside local Files documents, edit server configs with syntax highlighting, and queue concurrent uploads and downloads with conflict handling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルファイルと並べてリモートを閲覧し、シンタックスハイライト付きで設定を編集、競合解決付きの並列転送を行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 파일과 나란히 원격 파일 시스템을 탐색하고 구문 강조 편집 및 충돌 처리가 포함된 동시 업/다운로드를 지원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与本机「文件」同屏浏览远程文件系统，语法高亮编辑服务器配置，并支持带冲突处理的并发上传下载队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與本機「檔案」同屏瀏覽遠端檔案系統，語法突顯編輯伺服器設定，並支援帶衝突處理的併發上傳下載佇列。"
          }
        }
      }
    },
    "Browse, upload and download files over SFTP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse, upload and download files over SFTP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP でファイルの閲覧、アップロード、ダウンロードを行う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP를 통해 파일 탐색, 업로드 및 다운로드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 SFTP 浏览、上传和下载文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 SFTP 瀏覽、上傳與下載檔案"
          }
        }
      }
    },
    "Bugs and ideas go to the project's issue tracker.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugs and ideas go to the project's issue tracker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バグ報告やアイデアはプロジェクトの Issue トラッカーにお寄せください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버그 제보와 아이디어는 프로젝트의 이슈 트래커로 보내주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺陷和想法请提交到项目的问题跟踪器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
