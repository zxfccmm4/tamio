          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamio로 돌아오거나 Wi-Fi와 셀룰러 간 전환 시 끊긴 SSH 세션을 자동으로 다시 연결합니다."
          }
