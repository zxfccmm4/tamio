    "Create an SSH tunnel to securely forward local or remote ports through your saved servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an SSH tunnel to securely forward local or remote ports through your saved servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みサーバー経由で SSH トンネルを作成し、ローカルまたはリモートポートを安全に転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 서버를 통해 SSH 터널을 만들어 로컬 또는 원격 포트를 안전하게 포워딩하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过已保存的服务器创建 SSH 隧道，安全转发本地或远程端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過已儲存的伺服器建立 SSH 通道，安全轉發本機或遠端連接埠。"
          }
        }
      }
    },
    "Create local and remote SSH port forwards on the go, and discover or connect to Ghost Remote sessions over your local network or relay profiles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create local and remote SSH port forwards on the go, and discover or connect to Ghost Remote sessions over your local network or relay profiles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル/リモート SSH ポート転送を作成し、LAN やリレープロファイル経由で Ghost Remote セッションに接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 및 원격 SSH 포트 포워딩을 생성하고 LAN 또는 릴레이 프로필을 통해 Ghost Remote 세션에 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时创建本地与远程 SSH 端口转发，并通过局域网或中继配置发现与连接 Ghost Remote 会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時建立本機與遠端 SSH 連接埠轉發，並透過區域網路或中繼設定探索與連線 Ghost Remote 工作階段。"
          }
        }
      }
    },
    "Create snippets in the Snippets tab to run them in one tap from any terminal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create snippets in the Snippets tab to run them in one tap from any terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スニペット」タブでコマンドを作成すると、端末からワンタップで送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스니펫 탭에서 명령어를 만들면 어느 터미널에서나 한 번에 전송할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“代码片段”标签页中创建片段，即可在任意终端一键发送执行。"
          }
        },
        "zh-Hant": {
