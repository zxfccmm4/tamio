    "A matching server was added during review. Review the import again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching server was added during review. Review the import again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中に一致するサーバーが追加されました。インポートをもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토하는 동안 일치하는 서버가 추가되었습니다. 가져오기를 다시 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查期间新增了匹配的服务器。请重新检查导入内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查期間新增了相符的伺服器。請重新檢查匯入內容。"
          }
        }
      }
    },
