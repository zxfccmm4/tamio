      }
    },
    "This PuTTY key is encrypted. Enter its passphrase to import it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PuTTY key is encrypted. Enter its passphrase to import it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PuTTY 鍵は暗号化されています。インポートするにはパスフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PuTTY 키는 암호화되어 있습니다. 가져오려면 암호 구문을 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PuTTY 密钥已加密，请输入密码短语以导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PuTTY 金鑰已加密，請輸入密碼片語以匯入。"
          }
        }
      }
    },
    "This SSH configuration can execute local commands. Explicit trust is required before resolving it.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This SSH configuration can execute local commands. Explicit trust is required before resolving it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この SSH 設定はローカルコマンドを実行する可能性があります。解決するには明示的な信頼が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 SSH 구성은 로컬 명령을 실행할 수 있습니다. 확인하기 전에 명시적인 신뢰가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SSH 配置可执行本地命令。解析前需要明确授权信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SSH 設定可執行本機指令。解析前需要明確授權信任。"
          }
        }
      }
    },
    "This build is signed without Apple's managed Private Cloud Compute entitlement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is signed without Apple's managed Private Cloud Compute entitlement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには Apple の Private Cloud Compute エンタイトルメントが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 Apple의 관리형 비공개 클라우드 컴퓨팅 권한이 포함되어 있지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建未包含 Apple 受管的私有云计算 (PCC) 签名权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前建置未包含 Apple 受管的私有雲端運算 (PCC) 簽章權限。"
          }
        }
      }
    },
    "This configuration requires trust and may run local commands. Resolved settings are a snapshot, not live OpenSSH rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This configuration requires trust and may run local commands. Resolved settings are a snapshot, not live OpenSSH rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は信頼が必要であり、ローカルコマンドを実行する可能性があります。解決された設定はスナップショットであり、ライブの OpenSSH ルールではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구성은 신뢰가 필요하며 로컬 명령을 실행할 수 있습니다. 확인된 설정은 스냅샷이며 실시간 OpenSSH 규칙이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置需要信任，且可能运行本地命令。解析结果是快照，不是实时 OpenSSH 规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定需要信任，且可能會執行本機指令。解析結果為快照，並非即時 OpenSSH 規則。"
          }
        }
      }
    },
    "This copy of Tamio does not update itself; the release from GitHub does.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Tamio does not update itself; the release from GitHub does."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Tamio のコピーは自動更新されません。GitHub リリース版は自動更新に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Tamio 사본은 자동으로 업데이트되지 않습니다. GitHub 릴리스 버전은 자동 업데이트됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Tamio 副本不会自动更新；从 GitHub 下载的正式版会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Tamio 副本不會自動更新；從 GitHub 下載的正式版會。"
          }
        }
      }
    },
    "This copy of Tamio is not signed for iCloud, so it cannot sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Tamio is not signed for iCloud, so it cannot sync."
