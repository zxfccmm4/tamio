    "Private Cloud Compute is not ready yet. Check your network, iCloud sign-in, or app entitlement.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Compute の準備ができていません。ネットワーク、iCloud サインイン、またはアプリの権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 클라우드 컴퓨팅이 아직 준비되지 않았습니다. 네트워크, iCloud 로그인 또는 앱 권한을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私有云计算尚未就绪，请检查网络、iCloud 登录状态或应用权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私有雲端運算尚未就緒，請檢查網路、iCloud 登入狀態或 App 權限。"
          }
        }
      }
    },
    "Private Cloud Compute runs larger Apple Intelligence models on Apple Silicon servers with verifiable privacy (requires iOS 27+ and entitlement).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Compute は、検証可能なプライバシー保護を備えた Apple シリコンサーバー上でより大規模な Apple Intelligence モデルを実行します（iOS 27 以降および権限が必要）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 클라우드 컴퓨팅은 검증 가능한 개인정보 보호가 적용된 Apple Silicon 서버에서 더 큰 Apple Intelligence 모델을 실행합니다(iOS 27+ 및 권한 필요)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私有云计算在配备可验证隐私保护的 Apple 芯片服务器上运行更大规模的 Apple Intelligence 模型（需要 iOS 27+ 与相应签名权限）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私有雲端運算在具備可驗證隱私保護的 Apple 晶片伺服器上運行更大規模的 Apple Intelligence 模型（需要 iOS 27+ 與相應簽章權限）。"
          }
        }
      }
    },
