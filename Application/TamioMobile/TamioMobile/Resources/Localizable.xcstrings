    "%@ can't reach the Docker socket. Add the user to the docker group.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't reach the Docker socket. Add the user to the docker group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から Docker ソケットにアクセスできません。ユーザーを docker グループに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 Docker 소켓에 접근할 수 없습니다. 사용자를 docker 그룹에 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法访问 Docker 套接字，请将该用户加入 docker 组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法存取 Docker 通訊端，請將該使用者加入 docker 群組。"
          }
        }
      }
    },
