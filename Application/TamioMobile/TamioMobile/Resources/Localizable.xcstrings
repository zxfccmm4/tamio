    "OpenSSH known_hosts is not imported. Tamio keeps its own host-key verification and records a key on first connection; insecure OpenSSH trust settings are not copied.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH known_hosts is not imported. Tamio keeps its own host-key verification and records a key on first connection; insecure OpenSSH trust settings are not copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会导入 OpenSSH known_hosts。Tamio 保留独立的主机密钥验证，并在首次连接时记录密钥；不会复制不安全的 OpenSSH 信任设置。"
          }
        }
      }
    },
    "OpenSSH lists multiple identity files. Choose one credential explicitly; Tamio does not try this list in order.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH lists multiple identity files. Choose one credential explicitly; Tamio does not try this list in order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH 列出了多个身份文件。请明确选择一个凭据；Tamio 不会依次尝试此列表。"
          }
        }
      }
    },
    "OpenSSH local and remote commands are not imported.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSSH local and remote commands are not imported."
