    "setting.selection-background.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background color for selection. If not specified, inverts colors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲の背景色です。未指定の場合は色が反転されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역의 배경색입니다. 지정하지 않으면 색상이 반전됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中文本时的背景颜色。未指定时将采用反转色彩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取文字時的背景顏色。未指定時將採用反轉色彩。"
          }
        }
      }
    },
