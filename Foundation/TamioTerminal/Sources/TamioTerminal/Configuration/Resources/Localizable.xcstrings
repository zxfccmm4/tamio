    "setting.scrollback-limit.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory kept for lines that have scrolled off the top. Older lines drop once full."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上部にスクロールアウトした履歴行用に保持するメモリ上限です。満杯になると古い行から破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 위로 스크롤된 줄을 위해 유지할 메모리 한도입니다. 가득 차면 오래된 줄부터 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为滚出屏幕顶部的历史输出保留的最大内存。缓冲区写满后将丢弃最早的历史行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為捲出螢幕頂端的歷史輸出保留的最大記憶體。緩衝區寫滿後會捨棄最早的歷史行。"
          }
        }
      }
    },
    "setting.scrollback-limit.title": {
      "extractionState": "manual",
      "localizations": {
