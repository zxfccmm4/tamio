          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制后清除选区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製後清除選取範圍"
          }
        }
      }
    },
    "setting.selection-clear-on-typing.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether to clear selected text when typing into the terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルに入力したときに選択範囲を解除するかどうかを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 입력할 때 선택 영역을 해제할지 여부를 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中键入字符时是否自动取消当前文本选择。"
          }
        },
        "zh-Hant": {
