    "setting.theme.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A theme to use. Can be a built-in theme or a file path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するカラーテーマです。内蔵テーマ名またはテーマファイルのパスを指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 색상 테마입니다. 내장 테마 이름 또는 파일 경로를 지정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所采用的色彩主题。支持内置主题名称或主题文件路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
