    "setting.window-padding-balance.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread leftover space evenly around the grid when window padding is set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ余白が設定されているとき、余ったスペースをグリッドの周囲に均等に配分します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 여백이 설정된 경우 남은 공간을 터미널 그리드 주위에 균등하게 배분합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置窗口边距后，将剩余多出的空间均匀分配在终端网格四周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定視窗邊距後，將剩餘空間均勻分配在終端機格線四周。"
          }
        }
      }
    },
    "setting.window-padding-balance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance padding"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余白を均等配分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여백 균등 배분"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平分边缘留白"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡邊距留白"
          }
        }
      }
    },
    "setting.window-padding-color.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color of the padding area of the window. Can be background or extend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ余白領域の色です。背景色または端のセルの延長色を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 여백 영역의 색상입니다. 배경색 또는 가장자리 셀 확장 색상을 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
