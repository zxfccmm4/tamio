    "setting.title.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this instead of the title the remote host or running command reports."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートホストや実行中のコマンドが通知するタイトルの代わりに、この固定タイトルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 호스트나 실행 중인 명령어가 보고하는 제목 대신 이 고정 제목을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该固定标题替代远程主机或运行命令上报的动态标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此固定標題取代遠端主機或執行中指令回報的動態標題。"
          }
        }
      }
    },
    "setting.title.title": {
      "extractionState": "manual",
      "localizations": {
