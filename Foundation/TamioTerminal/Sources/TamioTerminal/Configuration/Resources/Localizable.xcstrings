    "setting.font-codepoint-map.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw specific Unicode ranges, such as icons or CJK text, with another font."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンや CJK 文字など、特定の Unicode 範囲を別のフォントで描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘이나 CJK 텍스트 등 특정 Unicode 범위의 문자를 다른 글꼴로 그립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
