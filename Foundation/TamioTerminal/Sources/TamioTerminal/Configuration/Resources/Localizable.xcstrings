          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔画加粗强度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆畫加粗強度"
          }
        }
      }
    },
    "setting.font-thicken.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw text with a heavier stroke, like Terminal.app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal.app のように、文字をより太いストロークで描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal.app처럼 텍스트를 더 굵은 획으로 그립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以更粗饱满的笔画绘制文本（类似于 macOS 自带 Terminal.app 的效果）。"
          }
        },
        "zh-Hant": {
