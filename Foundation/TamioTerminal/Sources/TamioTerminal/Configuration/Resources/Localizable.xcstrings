    "setting.font-feature.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn ligatures and stylistic alternates on or off for the primary font."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインフォントの合字や代替字形機能のオン／オフを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 글꼴의 합자 및 대체 자형 스타일 기능을 켜거나 끕니다."
          }
        },
        "zh-Hans": {
