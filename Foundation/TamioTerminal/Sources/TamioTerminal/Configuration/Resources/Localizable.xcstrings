    "setting.font-synthetic-style.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control whether Ghostty should synthesize bold, italic, or bold italic styles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するスタイルがフォントにない場合に、Ghostty が太字・斜体・太字斜体を合成するかどうかを制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴에 해당 스타일이 없을 때 Ghostty가 굵게, 기울임꼴 또는 굵은 기울임꼴 스타일을 합성할지 제어합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制当字体缺少对应字重时 Ghostty 是否人工合成粗体、斜体或粗斜体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制當字體缺少對應樣式時，Ghostty 是否合成粗體、斜體或粗斜體。"
          }
        }
      }
    },
