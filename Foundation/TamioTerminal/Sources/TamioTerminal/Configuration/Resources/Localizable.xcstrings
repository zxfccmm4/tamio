    "setting.selection-clear-on-copy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether to clear selected text after copying it to the clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストをクリップボードにコピーした後に選択を解除するかどうかを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 클립보드에 복사한 후 선택 영역을 해제할지 여부를 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选中文本复制到剪贴板后是否自动取消选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將選取文字複製到剪貼簿後是否自動取消選取。"
          }
        }
      }
    },
    "setting.selection-clear-on-copy.title": {
