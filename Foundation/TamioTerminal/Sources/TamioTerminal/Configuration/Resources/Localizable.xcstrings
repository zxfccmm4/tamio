    "keybinding.help.hidden_count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d of Ghostty's shortcuts are for windows, tabs and splits, which Tamio manages itself; they are not shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ、タブ、分割用の Ghostty ショートカット %d 件は Tamio が独自に管理しているため表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창, 탭 및 분할 화면용 Ghostty 단축키 %d개는 Tamio가 자체적으로 관리하므로 표시되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 中有 %d 个用于窗口、标签页与分屏的快捷键已由 Tamio 接管管理，此处不予显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty 中有 %d 個用於視窗、標籤頁與分割畫面的快速鍵已由 Tamio 自行管理，因此未顯示。"
          }
        }
      }
    },
    "keybinding.help.make_sequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a sequence: press the first keys, release, then the next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーケンスを作成: 最初のキーを押して離し、次のキーを押します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시퀀스 만들기: 첫 번째 키를 눌렀다가 뗀 다음, 다음 키를 누르세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建按键序列：按下第一组按键并松开，然后按下下一组按键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立按鍵序列：按下第一組按鍵後放開，再按下下一組按鍵"
          }
        }
      }
    },
