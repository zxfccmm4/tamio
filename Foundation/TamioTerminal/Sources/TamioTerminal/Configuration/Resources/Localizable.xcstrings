    "error.saved_config_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved configuration could not be read: %@. The original is retained until you explicitly save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された設定を読み込めませんでした：%@。明示的に保存するまで元の設定が保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 구성을 읽을 수 없습니다: %@. 명시적으로 저장할 때까지 기존 구성이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的配置：%@。在您显式保存前将保留原配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的設定：%@。在您明確儲存前將保留原設定。"
          }
        }
      }
    },
