        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Determines whether running programs can capture Shift+clicks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のプログラムが Shift+クリックをキャプチャできるかどうかを指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 프로그램이 Shift+클릭을 캡처할 수 있는지 여부를 결정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定运行中的终端程序是否可以捕获按住 Shift 键的鼠标点击事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定執行中的終端機程式是否可擷取按住 Shift 鍵的滑鼠點按事件。"
          }
        }
      }
    },
