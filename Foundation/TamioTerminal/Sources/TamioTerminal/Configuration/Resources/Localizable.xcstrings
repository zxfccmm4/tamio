    "setting.cursor-opacity.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The opacity level of the cursor. A value of 1.0 is fully opaque, 0.0 is fully transparent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルの不透明度。1.0 で完全な不透明、0.0 で完全な透明になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서의 불투명도 수준입니다. 1.0은 완전 불투명, 0.0은 완전 투명입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标的不透明度级别。1.0 为完全不透明，0.0 为完全透明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標的不透明度級別。1.0 為完全不透明，0.0 為完全透明。"
          }
        }
      }
    },
