    "setting.font-size.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size in points. ⌘+ and ⌘− change it for one session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズ（ポイント単位）。⌘+ と ⌘− で現在のセッションのみ一時的に変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 크기(포인트 단위)입니다. ⌘+ 및 ⌘−로 현재 세션에서만 크기를 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本字号（磅值）。⌘+ 和 ⌘− 可在当前会话中临时调整字号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小（點數）。⌘+ 與 ⌘− 可在目前工作階段中暫時調整大小。"
          }
        }
      }
    },
