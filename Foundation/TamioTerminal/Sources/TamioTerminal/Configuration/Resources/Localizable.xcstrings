    "setting.bold-color.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifies the color used for bold text in the terminal. Hex color or name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの太字テキストに使用する色を変更します。16 進カラーコードまたは色名で指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 굵은 텍스트에 사용할 색상을 변경합니다. 16진수 색상 코드 또는 색상 이름을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改终端中粗体文本的颜色。支持十六进制颜色值或颜色名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改終端機中粗體文字的顏色。可指定十六進位色碼或顏色名稱。"
          }
        }
      }
    },
