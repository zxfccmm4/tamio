    "setting.cursor-click-to-move.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-click at a prompt to move the cursor there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトで Option キーを押しながらクリックすると、カーソルをその位置に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트에서 Option 키를 누른 채 클릭하면 커서를 해당 위치로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令行提示符处按住 Option 键点按即可将光标移至该位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令列提示字元處按住 Option 鍵點按，即可將游標移至該位置。"
          }
        }
      }
    },
