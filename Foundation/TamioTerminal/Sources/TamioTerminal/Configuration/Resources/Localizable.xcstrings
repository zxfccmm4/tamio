        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不安全粘贴时确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不安全貼上時確認"
          }
        }
      }
    },
    "setting.clipboard-trim-trailing-spaces.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trims trailing whitespace on data that is copied to the clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにコピーするデータの末尾の空白を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 복사되는 데이터의 후행 공백을 제거합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制到剪贴板时自动去除数据行末的空白字符。"
          }
