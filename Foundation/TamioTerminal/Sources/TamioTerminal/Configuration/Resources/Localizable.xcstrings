    "setting.image-storage-limit.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory kept for images shown in the terminal. Once full, the oldest are dropped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルに表示する画像用に保持するメモリ上限です。上限に達すると古いものから破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 표시되는 이미지를 위해 유지할 메모리 한도입니다. 가득 차면 가장 오래된 이미지부터 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为终端中显示的图像保留的最大内存。超出后将丢弃最早的图像缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為終端機中顯示的圖片保留的最大記憶體。超過上限後會捨棄最舊的圖片快取。"
          }
        }
      }
