    "setting.background.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background color for the window. Specified as a hex color or name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウの背景色です。16 進カラーコードまたは色名で指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창의 배경색입니다. 16진수 색상 코드 또는 색상 이름으로 지정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口的背景颜色。支持十六进制颜色值或颜色名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗的背景顏色。可指定十六進位色碼或顏色名稱。"
          }
        }
      }
    },
