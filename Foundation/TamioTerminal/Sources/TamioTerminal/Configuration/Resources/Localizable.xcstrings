    "setting.palette.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color palette for the 256 color form. Syntax is 'index=hex'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "256 色モード用のカラーパレットです。構文は 'index=hex' です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "256색 모드용 색상 팔레트입니다. 구문은 'index=hex'입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
