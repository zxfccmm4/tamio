    "setting.vt-kam-allowed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If true, allows the 'KAM' mode (ANSI mode 2) to lock keyboard input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、「KAM」モード（ANSI モード 2）によるキーボード入力のロックを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 'KAM' 모드(ANSI 모드 2)로 키보드 입력을 잠그는 것을 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，允许终端程序使用 KAM 模式（ANSI 模式 2）锁定键盘输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，允許終端機程式使用 KAM 模式（ANSI 模式 2）鎖定鍵盤輸入。"
          }
        }
      }
    },
