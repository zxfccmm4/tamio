    "setting.font-family.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The typeface for terminal text, then fallbacks for characters it lacks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルテキストのメインフォントと、含まれない文字用のフォールバックフォントです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 텍스트의 기본 서체와 해당 서체에 없는 문자를 위한 대체 글꼴입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端文本的主字体，及其缺失字符的备选后备字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機文字的主字體，以及缺失字元的備選字體。"
          }
        }
      }
    },
