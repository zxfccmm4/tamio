    "setting.cursor-style-blink.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the cursor blinks; programs can still change it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソルを点滅させるかどうかを設定します。実行中のプログラムから動的に変更される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 깜박임 여부를 설정합니다. 실행 중인 프로그램이 이 동작을 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标是否闪烁；运行中的终端程序仍可动态改变此行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標是否閃爍；執行中的終端機程式仍可動態變更此行為。"
          }
        }
      }
    },
