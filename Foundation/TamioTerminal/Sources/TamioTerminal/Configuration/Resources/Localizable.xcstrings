    "setting.font-thicken-strength.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much heavier strokes are drawn while font-thicken is on (0 to 255)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントのストローク太字化が有効なときの太さの度合い（0〜255）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획 굵게 하기 기능이 켜져 있을 때 획을 얼마나 더 굵게 그릴지 설정합니다(0~255)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用字体笔画加粗时的增强强度（取值范围 0 至 255）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用字體筆畫加粗時的增強強度（範圍 0 至 255）。"
          }
        }
      }
    },
    "setting.font-thicken-strength.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thickening amount"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太字化の強さ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
