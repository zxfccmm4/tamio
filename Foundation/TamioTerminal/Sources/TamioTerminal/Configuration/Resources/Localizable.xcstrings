    "setting.copy-on-select.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether to automatically copy selected text to the clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストを自動的にクリップボードにコピーするかどうかを指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트를 자동으로 클립보드에 복사할지 여부를 설정합니다."
          }
        },
        "zh-Hans": {
