    "setting.font-family-bold-italic.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font family to use for bold italic text. Fallback to bold/italic if not set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "太字斜体テキストに使用するフォントファミリーです。未設定の場合は太字または斜体にフォールバックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "굵은 기울임꼴 텍스트에 사용할 글꼴 모음입니다. 설정하지 않으면 굵게 또는 기울임꼴로 대체됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于粗斜体文本的字体系列。未设置时自动回退到粗体或斜体字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於粗斜體文字的字體系列。未設定時自動退回至粗體或斜體字體。"
          }
        }
      }
    },
