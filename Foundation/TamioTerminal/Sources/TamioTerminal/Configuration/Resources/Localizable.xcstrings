    "dialog.reset_terminal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset every terminal setting to its default?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのターミナル設定をデフォルトにリセットしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 터미널 설정을 기본값으로 재설정하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有终端设置恢复为默认值？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將所有終端機設定回復為預設值嗎？"
          }
        }
      }
    },
