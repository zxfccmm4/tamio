          "stringUnit": {
            "state": "translated",
            "value": "Fixed session title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定セッションタイトル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
