    "setting.clipboard-paste-bracketed-safe.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If true, bracketed pastes will be considered safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ブラケットペースト（Bracketed Paste）が安全とみなされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 브래킷 붙여넣기(Bracketed Paste)가 안전한 것으로 간주됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，括号粘贴（Bracketed Paste）将被视为安全内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，括號貼上（Bracketed Paste）將被視為安全內容。"
          }
        }
      }
    },
    "setting.clipboard-paste-bracketed-safe.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark bracketed paste as safe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラケットペーストを安全とみなす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브래킷 붙여넣기를 안전으로 표시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将括号粘贴视为安全"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將括號貼上視為安全"
          }
        }
      }
    },
    "setting.clipboard-paste-protection.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require confirmation before pasting text with newlines or control characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改行や制御文字を含むテキストをペーストする前に確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 바꿈이나 제어 문자가 포함된 텍스트를 붙여넣기 전에 확인을 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴包含换行符或控制字符的文本时需要二次确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上包含換行符號或控制字元的文字時需要確認。"
          }
        }
      }
    },
    "setting.clipboard-paste-protection.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
