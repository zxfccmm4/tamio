    "setting.background-opacity-cells.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also make cells with their own background color translucent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の背景色を持つセルも半透明にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 배경색이 있는 셀도 반투명하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使自带背景颜色的单元格也呈现半透明效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使自帶背景顏色的儲存格也呈現半透明效果。"
          }
        }
      }
    },
    "setting.background-opacity-cells.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply opacity to colored cells"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きセルにも不透明度を適用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상이 있는 셀에 불투명도 적용"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对有色单元格应用透明度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對有色儲存格套用透明度"
          }
        }
      }
    },
    "setting.background-opacity.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below 1, the window behind shows through."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 未満にすると、背後のウィンドウが透けて見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1보다 작으면 뒤쪽 창이 비쳐 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小于 1 时，窗口背后的内容会透显出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小於 1 時，視窗背後的內容會透出顯示。"
          }
        }
      }
    },
    "setting.background-opacity.title": {
      "extractionState": "manual",
      "localizations": {
